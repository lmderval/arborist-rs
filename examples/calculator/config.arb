# Configuration variables
templates_dir = "./";

node_templates = [
  "node.cc.jinja",
  "node.hh.jinja",
];

# Enums creation
enum Operator {
  PLUS,
  MINUS,
}

# Nodes creation
node Exp {
  readable location: loc;
}

node IntExp(Exp) {
  readable value: i64;
}

node UnaryExp(Exp) {
  readable op: Operator;
  mutable exp: Exp;
}

node BinaryExp(Exp) {
  readable op: Operator;
  mutable lhs: Exp;
  mutable rhs: Exp;
}

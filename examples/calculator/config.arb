# Configuration variables
templates_dir = "./";

node_templates = [
  "node.cc.jinja",
  "node.hh.jinja",
];

# Enums creation
enum Operator {
  PLUS,
  MINUS,
}

# Nodes creation
node Exp {}

node IntExp(Exp) {
  readable value: i64;
}

node UnaryExp(Exp) {
  readable op: Operator;
  writable exp: Exp;
}

node BinaryExp(Exp) {
  readable op: Operator;
  writable lhs: Exp;
  writable rhs: Exp;
}

/**
 * \file {{ filename }}
 * \brief Declaration of all nodes and types.
 */

#pragma once

{% for dec in config.decs | selectattr("kind", "eq", "Enum") %}
enum {{ dec.name }} {
    {% for value in dec.values %}
    {{ value }},
    {% endfor %}
};
{% endfor %}

{% for dec in config.decs | selectattr("kind", "eq", "Node") %}
class {{ dec.name }};
{% endfor %}

{% from "c++/attributes" import
    render_read_attribute,
    render_write_attribute,
    render_mutate_attribute
%}
{% from "c++/constructors" import
    render_default_ctor_parameters,
    render_default_ctor_call_arguments
%}
{% from "c++/includes" import
    render_implementation_includes
%}
{% from "c++/types" import
    render_read_type,
    render_write_type,
    render_mutate_type
-%}

{% set attributes = node.decs | selectattr("kind", "eq", "Attr") | list -%}

/**
 * \file {{ filename }}
 * \brief Implementation of {{ node.name }}.
 */

#include "{{ node.name | snakecase }}.hh"

{{ render_implementation_includes(node) }}

{{ node.name }}::{{ node.name }}({{ render_default_ctor_parameters(node) }})
{%- set sep = joiner(",", ":") %}
{% for parent in node.parents
                 | map(attribute="dec")
                 | selectattr("kind", "eq", "Node") +%}
    {{ sep() }} {{ parent.name }}(
{{- render_default_ctor_call_arguments(parent) }})
{%- endfor %}
{% for attr in attributes +%}
    {{ sep() }} {{ attr.name }}_({{ render_write_attribute(attr) }})
{%- endfor %}
 {}

{% if not node.parents %}
{{ node.name }}::~{{ node.name }}() {}
{% endif %}

void {{ node.name }}::accept(ConstVisitor& v) const {
    v(*this);
}
void {{ node.name }}::accept(InvasiveVisitor& v) {
    v(*this);
}

{% for attr in attributes %}
    {% set mod = attr.modifier %}
    {% if mod.r %}
{{ render_read_type(attr.ty) }} {{ node.name }}::{{ attr.name }}_get() const {
    return {{ render_read_attribute(attr) }};
}
    {% endif %}
    {% if mod.w %}
void {{ node.name }}::{{ attr.name }}_set(
{{- render_write_type(attr.ty) }} {{ attr.name }}) {
    {{ attr.name }}_ = {{ render_write_attribute(attr) }};
}
    {% endif %}
    {% if mod.m %}
{{ render_mutate_type(attr.ty) }} {{ node.name }}::{{ attr.name }}_mut() {
    return {{ render_read_attribute(attr) }};
}
    {% endif %}
{% endfor %}

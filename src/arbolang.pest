Config = _{ SOI ~ Var* ~ Dec* ~ EOI }

Var = { VarId ~ "=" ~ Exp ~ ";" }

Exp = { IntExp | StringExp | ArrayExp }

IntExp = @{ ASCII_DIGIT+ }

StringExp = ${ "\"" ~ StringContent ~ "\"" }

StringContent = @{ (
      (!("\"" | "\\") ~ ANY)
    | ("\\" ~ ("\\" | "\""))
)* }

ArrayExp = { "[" ~ (Exp ~ ("," ~ Exp)* ~ ","?)? ~ "]" }

Dec = { NodeDec | EnumDec }

NodeDec = { "node" ~ TypeId ~ Parents ~ "{" ~ NodeBody ~ "}" }

EnumDec = { "enum" ~ TypeId ~ "{" ~ EnumValues ~ "}" }

AttrDec = { AttrMod ~ AttrId ~ ":" ~ Type ~ ";" }

EnumValues = { EnumId ~ ("," ~ EnumId)* ~ ","? }

Parents = { ("(" ~ TypeId ~ ("," ~ TypeId)* ~ ","? ~ ")")? }

AttrMod = { UserAttrMod | PrimitiveAttrMod }

UserAttrMod = { "access" ~ "<" ~ AttrModId ~ ">" }

PrimitiveAttrMod = { ("readable" | "writable" | "mutable")? }

NodeBody = { AttrDec* }

Type = { TypeId | PrimitiveType | CollectionType }

PrimitiveType = { "i8" | "i16" | "i32" | "i64" | "str" | "loc" }

CollectionType = { CollectionId ~ "<" ~ Type ~ ">" }

CollectionId = { "arr" | "vec" }

VarId = @{ ASCII_ALPHA_LOWER ~ (ASCII_ALPHA | "_")* }

TypeId = @{ ASCII_ALPHA_UPPER ~ ASCII_ALPHA* }

EnumId = @{ ASCII_ALPHA_UPPER+ }

AttrId = @{ ASCII_ALPHA_LOWER ~ (ASCII_ALPHA | "_")* }

AttrModId = @{ ("r" | "w" | "m")* }

COMMENT = _{ "#" ~ (!"\n" ~ ANY)* }

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
